{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|Read|Grep|Glob|View|Write|Edit|Skill|Agent",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/helpers/perf/perf-auto-log.cjs",
                        "timeout": 3000
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/helpers/hook-handler.cjs pre-bash",
                        "timeout": 5000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/helpers/tokenforge-hook.cjs",
                        "timeout": 3000
                    },
                    {
                        "type": "command",
                        "command": "lean-ctx hook rewrite",
                        "timeout": 5000
                    }
                ]
            },
            {
                "matcher": "Read|Grep|Glob|View",
                "hooks": [
                    {
                        "type": "command",
                        "command": "lean-ctx hook redirect",
                        "timeout": 5000
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/isolation-enforcer.cjs",
                        "timeout": 5000
                    }
                ]
            },
            {
                "matcher": "Skill",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/gate-keeper.cjs",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/artifact-tracker.cjs",
                        "timeout": 3000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/hooks/phase-tracker.cjs",
                        "timeout": 5000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/helpers/hook-handler.cjs post-edit",
                        "timeout": 10000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/helpers/alignment-hook.cjs check",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/helpers/hook-handler.cjs session-restore",
                        "timeout": 15000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/hooks/auto-memory-hook.mjs import",
                        "timeout": 8000
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/helpers/hook-handler.cjs session-end",
                        "timeout": 10000
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/helpers/auto-memory-hook.mjs sync",
                        "timeout": 10000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/helpers/perf/sync-lean-ctx.cjs",
                        "timeout": 8000
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/isolation-enforcer.cjs --register-agent",
                        "timeout": 3000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/helpers/hook-handler.cjs status",
                        "timeout": 3000
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/phase-tracker.cjs --check-completion",
                        "timeout": 5000
                    },
                    {
                        "type": "command",
                        "command": "node .claude/helpers/hook-handler.cjs post-task",
                        "timeout": 5000
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(npx @claude-flow*)",
            "Bash(npx claude-flow*)",
            "Bash(node .claude/*)",
            "mcp__claude-flow__:*",
            "Bash(node .claude/hooks/*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)"
        ]
    },
    "verbose": true,
    "attribution": {
        "commit": "Co-Authored-By: claude-flow <ruv@ruv.net>",
        "pr": "🤖 Generated with [claude-flow](https://github.com/ruvnet/claude-flow)"
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "CLAUDE_FLOW_V3_ENABLED": "true",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDECODENOFLICKER": "1",
        "CLAUDE_CODE_ALWAYS_THINKING": "0",
            "CLAUDE_CODE_STREAM_DELAY": "0"
    },
    "model": "deepseek-v4-flash",
    "modelPreferences": {
        "preferred": "deepseek-v4-flash",
        "fallbacks": [
            "deepseek-v4-pro"
        ],
        "automaticallySwitch": true
    },
    "mcpServers": {
        "lean-ctx": {
            "command": "lean-ctx",
            "args": []
        }
    }
}
